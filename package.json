{
  "name": "playwright-ts",
  "version": "1.0.0",
  "description": "Playwright automation with Allure reporting",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf allure-results allure-report",
    "test": "npm run clean && npx playwright test",
    "test:chromium": "npm run clean && npx playwright test --project=Chromium",
    "test:firefox": "npm run clean && npx playwright test --project=Firefox",
    "generate-report": "allure generate ./allure-results --clean -o ./allure-report",
    "open-report": "allure open ./allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "allure-playwright": "^2.15.1",
    "typescript": "^5.8.3",
    "rimraf": "^5.0.5"
  }
}
